{
  "name": "@ankhorage/rules-design",
  "version": "0.9.0",
  "description": "Declarative catalog for reusable design rules.",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/rules-design#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/rules-design/issues"
  },
  "keywords": [
    "ankhorage",
    "design",
    "rules"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    }
  },
  "ankh": {
    "category": "rules-design",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "rules-design.recognize",
        "owner": "@ankhorage/rules-design",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Recognize website design",
        "description": "Assemble canonical website recognition from an observation document."
      },
      {
        "id": "rules-design.inspect",
        "owner": "@ankhorage/rules-design",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect website recognition",
        "description": "Read an existing canonical website recognition document."
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/rules-design.git"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "knip:check": "ankhorage-knip",
    "test:packed-consumer": "bun test/packed-consumer.ts",
    "test:php-consumer": "bun test/php-consumer.ts",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "docs": "paradox"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "@ankhorage/devtools": "^2.3.47",
    "@ankhorage/paradox": "^0.3.6"
  },
  "dependencies": {
    "@ankhorage/ankh": "^0.13.4",
    "@ankhorage/capability": "^0.2.2",
    "@ankhorage/contracts": "^26.9.0",
    "@ankhorage/rules": "^0.4.0",
    "@ankhorage/utility": "^1.10.0"
  }
}
