{
  "name": "@ankhorage/rules-design",
  "version": "0.2.0",
  "description": "Declarative catalog for reusable design rules.",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/rules-design#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/rules-design/issues"
  },
  "keywords": [
    "ankhorage",
    "design",
    "rules"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/rules-design.git"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "knip:check": "ankhorage-knip",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "docs": "paradox"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "@ankhorage/devtools": "^2.3.47",
    "@ankhorage/paradox": "^0.3.6"
  },
  "dependencies": {
    "@ankhorage/rules": "^0.3.0"
  }
}
