{
  "name": "@ankhorage/rules-design",
  "version": "0.0.0",
  "description": "Declarative catalog for reusable design rules.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/rules-design.git"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "bun x tsc --noEmit -p tsconfig.json",
    "knip:check": "bun x knip",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "knip": "^5.76.0",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3"
  }
}
